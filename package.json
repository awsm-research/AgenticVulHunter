{
  "name": "agenticbughunter",
  "version": "0.7.0",
  "description": "Model-agnostic agentic secure code review with a live local dashboard",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agenticbughunter": "bin/agenticbughunter.mjs",
    "abh": "bin/agenticbughunter.mjs"
  },
  "files": [
    "bin/",
    "src/**/*.py",
    "src/**/*.md",
    "src/**/*.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test tests-js/*.test.mjs",
    "start": "node bin/agenticbughunter.mjs dashboard"
  },
  "keywords": [
    "security",
    "code-review",
    "vulnerability",
    "cwe",
    "llm"
  ]
}
