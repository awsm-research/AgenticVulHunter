[A,curveMath.c,83] // TODO - Montgomery ladder
[A,curveMath.c,84] void pointMul(const Point * pointP, Point * pointR, const mpz_t d, Curve * curve) {
[A,curveMath.c,85]     int isInf = 1;
[A,curveMath.c,86]     char * dbits = mpz_get_str(NULL, 2, d);
[A,curveMath.c,87] 
[A,curveMath.c,88]     Point p, tmp;
[A,curveMath.c,89]     mpz_inits(tmp.x, tmp.y, pointR->x, pointR->y, NULL);
[A,curveMath.c,90]     mpz_init_set(p.x, pointP->x);
[A,curveMath.c,91]     mpz_init_set(p.y, pointP->y);
[A,curveMath.c,92] 
[A,curveMath.c,93]     for(int i = mpz_sizeinbase(d, 2) - 1; i >= 0; i--) {
[A,curveMath.c,94]         if(dbits[i] == '1') {
[A,curveMath.c,95]             if(isInf == 1) {
[A,curveMath.c,96]                 mpz_set(pointR->x, p.x);
[A,curveMath.c,97]                 mpz_set(pointR->y, p.y);
[A,curveMath.c,98]                 isInf = 0;
[A,curveMath.c,99]             }
[A,curveMath.c,100]             else {
[A,curveMath.c,101]                 mpz_set(tmp.x, pointR->x);
[A,curveMath.c,102]                 mpz_set(tmp.y, pointR->y);
[A,curveMath.c,103]                 pointAdd(&p, &tmp, pointR, curve);
[A,curveMath.c,104]             }
[A,curveMath.c,105]         }
[A,curveMath.c,106] 
[A,curveMath.c,107]         mpz_set(tmp.x, p.x);
[A,curveMath.c,108]         mpz_set(tmp.y, p.y);
[A,curveMath.c,109]         pointDouble(&tmp, &p, curve);
[A,curveMath.c,110]     }
[A,curveMath.c,111] 
[A,curveMath.c,112]     mpz_clears(p.x, p.y, tmp.x, tmp.y, NULL);
[A,curveMath.c,113] }
