[A,curveMath.c,18] 
[A,curveMath.c,19] void pointDouble(const Point * pointP, Point * pointR, Curve * curve) {
[A,curveMath.c,20]     mpz_t numer, denom, lambda;
[A,curveMath.c,21]     mpz_inits(numer, denom, lambda, NULL);
[A,curveMath.c,22] 
[A,curveMath.c,23]     // calculate lambda
[A,curveMath.c,24]     mpz_mul(numer, pointP->x, pointP->x);
[A,curveMath.c,25]     mpz_mul_ui(numer, numer, 3);
[A,curveMath.c,26]     mpz_add(numer, numer, curve->a);
[A,curveMath.c,27]     mpz_mod(numer, numer, curve->p);
[A,curveMath.c,28]     mpz_mul_ui(denom, pointP->y, 2);
[A,curveMath.c,29]     mpz_mod(denom, denom, curve->p);
[A,curveMath.c,30]     mpz_invert(denom, denom, curve->p);  // TODO check status
[A,curveMath.c,31]     mpz_mul(lambda, numer, denom);
[A,curveMath.c,32]     mpz_mod(lambda, lambda, curve->p);
[A,curveMath.c,33] 
[A,curveMath.c,34]     // calculate resulting x coord
[A,curveMath.c,35]     mpz_mul(pointR->x, lambda, lambda);
[A,curveMath.c,36]     mpz_sub(pointR->x, pointR->x, pointP->x);
[A,curveMath.c,37]     mpz_sub(pointR->x, pointR->x, pointP->x);
[A,curveMath.c,38]     mpz_mod(pointR->x, pointR->x, curve->p);
[A,curveMath.c,39] 
[A,curveMath.c,40]     //calculate resulting y coord
[A,curveMath.c,41]     mpz_sub(pointR->y, pointP->x, pointR->x);
[A,curveMath.c,42]     mpz_mul(pointR->y, lambda, pointR->y);
[A,curveMath.c,43]     mpz_sub(pointR->y, pointR->y, pointP->y);
[A,curveMath.c,44]     mpz_mod(pointR->y, pointR->y, curve->p);
[A,curveMath.c,45] 
[A,curveMath.c,46]     mpz_clears(numer, denom, lambda, NULL);
[A,curveMath.c,47] }
[A,curveMath.c,48] 
[A,curveMath.c,49] 
[A,curveMath.c,50] void pointAdd(const Point * pointP, const Point * pointQ, Point * pointR, Curve * curve) {
[A,curveMath.c,51]     if(pointEqual(pointP, pointQ)) {
[A,curveMath.c,52]         return pointDouble(pointP, pointR, curve);
[A,curveMath.c,53]     }
[A,curveMath.c,54] 
[A,curveMath.c,55]     mpz_t xdiff, ydiff, lambda;
[A,curveMath.c,56]     mpz_inits(xdiff, ydiff, lambda, NULL);
[A,curveMath.c,57] 
[A,curveMath.c,58]     // calculate lambda
[A,curveMath.c,59]     mpz_sub(ydiff, pointQ->y, pointP->y);
[A,curveMath.c,60]     mpz_mod(ydiff, ydiff, curve->p);
[A,curveMath.c,61]     mpz_sub(xdiff, pointQ->x, pointP->x);
[A,curveMath.c,62]     mpz_mod(xdiff, xdiff, curve->p);
[A,curveMath.c,63]     mpz_invert(xdiff, xdiff, curve->p);  // TODO check status
[A,curveMath.c,64]     mpz_mul(lambda, ydiff, xdiff);
[A,curveMath.c,65]     mpz_mod(lambda, lambda, curve->p);
[A,curveMath.c,66] 
[A,curveMath.c,67]     // calculate resulting x coord
[A,curveMath.c,68]     mpz_mul(pointR->x, lambda, lambda);
[A,curveMath.c,69]     mpz_sub(pointR->x, pointR->x, pointP->x);
[A,curveMath.c,70]     mpz_sub(pointR->x, pointR->x, pointQ->x);
[A,curveMath.c,71]     mpz_mod(pointR->x, pointR->x, curve->p);
[A,curveMath.c,72] 
[A,curveMath.c,73]     //calculate resulting y coord
[A,curveMath.c,74]     mpz_sub(pointR->y, pointP->x, pointR->x);
[A,curveMath.c,75]     mpz_mul(pointR->y, lambda, pointR->y);
[A,curveMath.c,76]     mpz_sub(pointR->y, pointR->y, pointP->y);
[A,curveMath.c,77]     mpz_mod(pointR->y, pointR->y, curve->p);
[A,curveMath.c,78] 
[A,curveMath.c,79]     mpz_clears(xdiff, ydiff, lambda, NULL);
[A,curveMath.c,80] }
