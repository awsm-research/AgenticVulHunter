[A,curveMath.c,5] int pointEqual(const Point * pointA, const Point * pointB) {
[A,curveMath.c,6]     // check x coords
[A,curveMath.c,7]     if(mpz_cmp(pointA->x, pointB->x) != 0) {
[A,curveMath.c,8]         return 0;
[A,curveMath.c,9]     }
[A,curveMath.c,10]     // check y coords
[A,curveMath.c,11]     if(mpz_cmp(pointA->y, pointB->y) != 0) {
[A,curveMath.c,12]         return 0;
[A,curveMath.c,13]     }
[A,curveMath.c,14] 
[A,curveMath.c,15]     return 1;
[A,curveMath.c,16] }
