forEach(charset => {\n58:             try {\n59:                 if (mode === \"Decode\") {\n60:                     output[charset] = cptable.utils.decode(IO_FORMAT[charset], input);\n61:                 } else {\n62:                     output[charset] = Utils.arrayBufferToStr(cptable.utils.encode(IO_FORMAT[charset], input));\n63:                 }\n64:             } catch (err) {\n65:                 output[charset] = \"Could not decode.\";\n66:             }\n67:         });\n68: \n69:         return output;\n70:     }\n71: \n72:     /**\n73:      * Displays the encodings in an HTML table for web apps.\n74:      *\n75:      * @param {Object[]} encodings\n76:      * @returns {html}\n77:      */\n78:     present(encodings) {\n79:         let table = \"<table class='table table-hover table-sm table-bordered table-nonfluid'><tr><th>Encoding</th><th>Value</th></tr>\";\n80: \n81:         for (const enc in encodings) {\n82:             const value = Utils.printable(encodings[enc], true);\n83:             table += `<tr><td>${enc}</td><td>${value}</td></tr>`;\n84:         }\n85: \n86:         table += \"<table>\";\n87:         return table;\n88:     }\n89: \n90: }\n91: \n92: export default TextEncodingBruteForce;"}}}
