[A,index.js,1] /**
[A,index.js,2]  * Set given `path`
[A,index.js,3]  *
[A,index.js,4]  * @param {Object} obj
[A,index.js,5]  * @param {String} path
[A,index.js,6]  * @param {Mixed} val
[A,index.js,7]  * @api public
