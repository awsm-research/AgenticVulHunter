[A,index.js,9] 
[A,index.js,10] exports.set = function (obj, path, val) {
[A,index.js,11]   var segs = path.split('.');
[A,index.js,12]   var attr = segs.pop();
[A,index.js,13]   
[A,index.js,14]   for (var i = 0; i < segs.length; i++) {
[A,index.js,15]     var seg = segs[i];
[A,index.js,16]     obj[seg] = obj[seg] || {};
[A,index.js,17]     obj = obj[seg];
[A,index.js,18]   }
[A,index.js,19]   
[A,index.js,20]   obj[attr] = val;
[A,index.js,21] };
[A,index.js,22] 
[A,index.js,23] /**
[A,index.js,24]  * Get given `path`
[A,index.js,25]  *
[A,index.js,26]  * @param {Object} obj
[A,index.js,27]  * @param {String} path
[A,index.js,28]  * @return {Mixed}
[A,index.js,29]  * @api public
[A,index.js,30]  */
[A,index.js,31] 
[A,index.js,32] exports.get = function (obj, path) {
[A,index.js,33]   var segs = path.split('.');
[A,index.js,34]   var attr = segs.pop();
[A,index.js,35]   
[A,index.js,36]   for (var i = 0; i < segs.length; i++) {
[A,index.js,37]     var seg = segs[i];
[A,index.js,38]     if (!obj[seg]) return;
[A,index.js,39]     obj = obj[seg];
