{
  "llm": {
    "base_url": "http://host.docker.internal:11435/v1",
    "api_key": "***REDACTED***",
    "model": "qwen3-coder:30b",
    "timeout_seconds": 800.0,
    "max_tokens": 6000,
    "temperature": 0.0,
    "provider": "openai",
    "send_temperature": true,
    "token_limit_field": "max_tokens",
    "system_role": "system",
    "max_retries": 2,
    "retry_backoff_seconds": 1.0,
    "max_input_chars": 240000,
    "extra_body": {}
  },
  "bm25": {
    "enabled": true,
    "top_k": 10,
    "max_requests_per_candidate": 4
  },
  "pipeline": {
    "max_candidates": 2147483647,
    "max_hypotheses": 5,
    "confidence_threshold": 0.8,
    "skip_stage2": true,
    "block_on_findings": false,
    "isolate_worktree": false,
    "keep_worktree": false
  },
  "agents": {
    "stage1_max_steps": 50,
    "stage2_max_steps": 50,
    "stage3_max_steps": 50,
    "stage4_mode": "api",
    "stage4_max_steps": 10
  },
  "repository": {
    "context_radius": 200,
    "max_read_lines": 300,
    "max_search_results": 30
  },
  "ui": {
    "banner": true,
    "live_progress": true,
    "show_config": true,
    "show_stage_details": true
  }
}
