[A,README.md,1] # mixin-deep [![NPM version](https://badge.fury.io/js/mixin-deep.svg)](http://badge.fury.io/js/mixin-deep)
[A,README.md,2] 
[A,README.md,3] 
[A,README.md,4] > Deeply mix the properties of objects into the first object, while also mixing-in child objects.
[A,README.md,5] 
[A,README.md,6] ## Install
[A,README.md,7] #### Install with [npm](npmjs.org):
[A,README.md,8] 
[A,README.md,9] ```bash
[A,README.md,10] npm i mixin-deep --save-dev
[A,README.md,11] ```
[A,README.md,12] 
[A,README.md,13] ## Run tests
[A,README.md,14] 
[A,README.md,15] ```bash
[A,README.md,16] npm test
[A,README.md,17] ```
[A,README.md,18] 
[A,README.md,19] ## Usage
[A,README.md,20] 
[A,README.md,21] ```js
[A,README.md,22] var mixinDeep = require('mixin-deep');
[A,README.md,23] 
[A,README.md,24] mixinDeep({a: {aa: 'aa'}}, {a: {bb: 'bb'}}, {a: {cc: 'cc'}});
[A,README.md,25] //=> { a: { aa: 'aa', bb: 'bb', cc: 'cc' } }
[A,README.md,26] 
[A,README.md,27] mixinDeep({a: {aa: 'aa', dd: {ee: 'ff'}}}, {a: {bb: 'bb', dd: {gg: 'hh'}}}, {a: {cc: 'cc', dd: {ii: 'jj'}}});
[A,README.md,28] //=> { a: { aa: 'aa', dd: { ee: 'ff', gg: 'hh', ii: 'jj' }, bb: 'bb', cc: 'cc' } }
[A,README.md,29] ```
[A,README.md,30] 
