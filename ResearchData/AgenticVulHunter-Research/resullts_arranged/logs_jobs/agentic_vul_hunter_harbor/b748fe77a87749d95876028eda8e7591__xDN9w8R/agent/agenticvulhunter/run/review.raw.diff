diff --git a/scripts/dns-lookup-script.js b/scripts/dns-lookup-script.js
new file mode 100644
index 0000000..9fc28fc
--- /dev/null
+++ b/scripts/dns-lookup-script.js
@@ -0,0 +1,15 @@
+'use strict';
+
+var dns = require('dns'),
+    name = process.argv[2],
+    debug = require('debug')('dns-sync');
+
+dns.lookup(name, function (err, ip) {
+    if (err) {
+        process.exit(1);
+        debug(err);
+    } else {
+        debug(name, 'resolved to', ip);
+        process.stdout.write(ip);
+    }
+});
