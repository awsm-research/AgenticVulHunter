 def combine(*args):
     """
     Combines all non-UNSET args, by shallow merging mappings and concatenating sequences
 
     >>> combine({'a': 1, 'b': 2}, UNSET, {'b': 3, 'c': 4}, UNSET)
     {'a': 1, 'b': 3, 'c': 4}
