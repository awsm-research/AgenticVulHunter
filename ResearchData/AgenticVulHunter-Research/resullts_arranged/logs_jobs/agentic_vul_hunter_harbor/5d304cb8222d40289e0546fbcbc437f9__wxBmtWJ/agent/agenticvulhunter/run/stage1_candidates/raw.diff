diff --git a/index.js b/index.js
index c75a6a7..b0d94a0 100644
--- a/index.js
+++ b/index.js
@@ -33,15 +33,37 @@ exports.set = function (obj, path, val) {
  * @api public
  */
 
 exports.get = function (obj, path) {
   var segs = path.split('.');
   var attr = segs.pop();
 
   for (var i = 0; i < segs.length; i++) {
     var seg = segs[i];
     if (!obj[seg]) return;
     obj = obj[seg];
   }
 
   return obj[attr];
 };
+
+/**
+ * Delete given `path`
+ *
+ * @param {Object} obj
+ * @param {String} path
+ * @return {Mixed}
+ * @api public
+ */
+
+exports.delete = function (obj, path) {
+  var segs = path.split('.');
+  var attr = segs.pop();
+
+  for (var i = 0; i < segs.length; i++) {
+    var seg = segs[i];
+    if (!obj[seg]) return;
+    obj = obj[seg];
+  }
+
+  delete obj[attr];
+};
