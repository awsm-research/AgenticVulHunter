{
    "metadata": {
        "version": "1.0",
        "description": "Essential secure code review guidelines for developers",
        "total_guidelines": 25
    },
    "guidelines": [
        {
            "id": "SCR-001",
            "category": "input_validation",
            "priority": "critical",
            "title": "Validate all user inputs at application boundaries",
            "essential_checks": [
                "Is user input validated before first use?",
                "Are validation failures handled securely?",
                "Is validation consistent across all entry points?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "request.getParameter() → database query",
                        "example": "String sql = \"SELECT * FROM users WHERE id = \" + request.getParameter(\"id\");",
                        "risk": "SQL injection"
                    },
                    {
                        "pattern": "user_input → file operations",
                        "example": "File file = new File(\"/uploads/\" + filename);",
                        "risk": "Path traversal"
                    }
                ]
            },
            "remediation_steps": [
                "Add server-side validation for all external inputs",
                "Use parameterized queries for database operations",
                "Implement input sanitization for output contexts"
            ],
            "related_guidelines": [
                "SCR-002",
                "SCR-003",
                "SCR-015"
            ]
        },
        {
            "id": "SCR-002",
            "category": "injection_prevention",
            "priority": "critical",
            "title": "Use parameterized queries for all database operations",
            "essential_checks": [
                "Are all SQL queries using prepared statements?",
                "Is dynamic query building avoided?",
                "Are stored procedures called safely?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "String concatenation in SQL",
                        "example": "\"SELECT * FROM users WHERE name = '\" + userName + \"'\"",
                        "risk": "SQL injection"
                    },
                    {
                        "pattern": "String.format() with SQL",
                        "example": "String.format(\"DELETE FROM %s WHERE id = %s\", table, id)",
                        "risk": "SQL injection"
                    }
                ]
            },
            "remediation_steps": [
                "Replace string concatenation with PreparedStatement",
                "Use ORM query builders with parameter binding",
                "Validate table/column names against allowlists"
            ],
            "related_guidelines": [
                "SCR-001",
                "SCR-003"
            ]
        },
        {
            "id": "SCR-003",
            "category": "output_encoding",
            "priority": "high",
            "title": "Encode output based on context (HTML, JavaScript, CSS, URL)",
            "essential_checks": [
                "Is user data encoded before output to HTML?",
                "Are different encoding methods used for different contexts?",
                "Is output encoding applied consistently?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "Direct output to HTML",
                        "example": "response.getWriter().println(\"<div>\" + userInput + \"</div>\");",
                        "risk": "XSS"
                    },
                    {
                        "pattern": "innerHTML with user data",
                        "example": "element.innerHTML = userInput;",
                        "risk": "DOM-based XSS"
                    }
                ]
            },
            "remediation_steps": [
                "Use HTML entity encoding for HTML context",
                "Use JavaScript encoding for JS context",
                "Use URL encoding for URL parameters"
            ],
            "related_guidelines": [
                "SCR-001",
                "SCR-004"
            ]
        },
        {
            "id": "SCR-004",
            "category": "authentication",
            "priority": "critical",
            "title": "Implement proper authentication checks on all protected resources",
            "essential_checks": [
                "Are authentication checks present on protected endpoints?",
                "Is authentication verified before authorization?",
                "Are authentication failures handled securely?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "Missing authentication check",
                        "example": "public void deleteUser(int userId) { // No auth check }",
                        "risk": "Unauthorized access"
                    },
                    {
                        "pattern": "Client-side authentication only",
                        "example": "if (isLoggedIn) { showAdminPanel(); } // Client-side only",
                        "risk": "Authentication bypass"
                    }
                ]
            },
            "remediation_steps": [
                "Add authentication checks to all protected methods",
                "Use centralized authentication mechanisms",
                "Implement proper session management"
            ],
            "related_guidelines": [
                "SCR-005",
                "SCR-006"
            ]
        },
        {
            "id": "SCR-005",
            "category": "authorization",
            "priority": "critical",
            "title": "Verify user permissions for each protected action",
            "essential_checks": [
                "Are authorization checks performed after authentication?",
                "Is the principle of least privilege applied?",
                "Are indirect object references protected?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "Missing authorization check",
                        "example": "public void viewUserProfile(int userId) { return getUser(userId); }",
                        "risk": "Unauthorized data access"
                    },
                    {
                        "pattern": "Role-based check only",
                        "example": "if (user.isAdmin()) { // Missing resource-specific check }",
                        "risk": "Privilege escalation"
                    }
                ]
            },
            "remediation_steps": [
                "Implement resource-level authorization checks",
                "Use access control matrices or RBAC",
                "Validate user ownership of resources"
            ],
            "related_guidelines": [
                "SCR-004",
                "SCR-006"
            ]
        },
        {
            "id": "SCR-006",
            "category": "session_management",
            "priority": "high",
            "title": "Implement secure session management",
            "essential_checks": [
                "Are session IDs generated securely?",
                "Are sessions invalidated on logout?",
                "Are session timeouts implemented?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "Predictable session ID",
                        "example": "sessionId = userId + timestamp;",
                        "risk": "Session hijacking"
                    },
                    {
                        "pattern": "No session invalidation",
                        "example": "// Logout without session.invalidate()",
                        "risk": "Session fixation"
                    }
                ]
            },
            "remediation_steps": [
                "Use cryptographically secure session ID generation",
                "Implement proper session invalidation",
                "Set appropriate session timeouts"
            ],
            "related_guidelines": [
                "SCR-004",
                "SCR-005"
            ]
        },
        {
            "id": "SCR-007",
            "category": "cryptography",
            "priority": "high",
            "title": "Use strong cryptographic algorithms and proper key management",
            "essential_checks": [
                "Are approved cryptographic algorithms used?",
                "Are cryptographic keys managed securely?",
                "Is random number generation cryptographically secure?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "Weak encryption algorithm",
                        "example": "Cipher cipher = Cipher.getInstance(\"DES\");",
                        "risk": "Weak encryption"
                    },
                    {
                        "pattern": "Hardcoded cryptographic key",
                        "example": "String key = \"mySecretKey123\";",
                        "risk": "Key exposure"
                    },
                    {
                        "pattern": "Weak random generation",
                        "example": "Random rand = new Random(); // Not cryptographically secure",
                        "risk": "Predictable values"
                    }
                ]
            },
            "remediation_steps": [
                "Use AES-256 or other approved algorithms",
                "Store keys in secure key management systems",
                "Use SecureRandom for cryptographic operations"
            ],
            "related_guidelines": [
                "SCR-008",
                "SCR-009"
            ]
        },
        {
            "id": "SCR-008",
            "category": "password_security",
            "priority": "high",
            "title": "Implement secure password handling and storage",
            "essential_checks": [
                "Are passwords hashed with strong algorithms?",
                "Are salts used for password hashing?",
                "Are passwords never logged or stored in plain text?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "Plain text password storage",
                        "example": "user.setPassword(plainTextPassword);",
                        "risk": "Password exposure"
                    },
                    {
                        "pattern": "Weak hashing algorithm",
                        "example": "String hash = md5(password);",
                        "risk": "Password cracking"
                    },
                    {
                        "pattern": "Password in logs",
                        "example": "logger.info(\"Login attempt: \" + username + \"/\" + password);",
                        "risk": "Password disclosure"
                    }
                ]
            },
            "remediation_steps": [
                "Use bcrypt, scrypt, or Argon2 for password hashing",
                "Generate unique salts for each password",
                "Never log or transmit passwords in plain text"
            ],
            "related_guidelines": [
                "SCR-007",
                "SCR-009"
            ]
        },
        {
            "id": "SCR-009",
            "category": "data_protection",
            "priority": "high",
            "title": "Protect sensitive data in transit and at rest",
            "essential_checks": [
                "Is sensitive data encrypted in transit?",
                "Is sensitive data encrypted at rest?",
                "Are encryption keys properly managed?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "HTTP for sensitive data",
                        "example": "http://api.example.com/login // Should be HTTPS",
                        "risk": "Data interception"
                    },
                    {
                        "pattern": "Unencrypted database storage",
                        "example": "CREATE TABLE users (ssn VARCHAR(11)); // No encryption",
                        "risk": "Data exposure"
                    }
                ]
            },
            "remediation_steps": [
                "Use HTTPS/TLS for all sensitive communications",
                "Encrypt sensitive database columns",
                "Implement proper certificate validation"
            ],
            "related_guidelines": [
                "SCR-007",
                "SCR-008"
            ]
        },
        {
            "id": "SCR-010",
            "category": "error_handling",
            "priority": "medium",
            "title": "Implement secure error handling without information disclosure",
            "essential_checks": [
                "Do error messages avoid revealing system details?",
                "Are errors logged appropriately for debugging?",
                "Are exceptions handled gracefully?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "Detailed error messages",
                        "example": "catch (SQLException e) { return e.getMessage(); }",
                        "risk": "Information disclosure"
                    },
                    {
                        "pattern": "Stack traces to user",
                        "example": "response.getWriter().println(exception.getStackTrace());",
                        "risk": "System information leak"
                    }
                ]
            },
            "remediation_steps": [
                "Return generic error messages to users",
                "Log detailed errors for developers only",
                "Implement centralized error handling"
            ],
            "related_guidelines": [
                "SCR-011",
                "SCR-012"
            ]
        },
        {
            "id": "SCR-011",
            "category": "logging_security",
            "priority": "medium",
            "title": "Implement secure logging practices",
            "essential_checks": [
                "Are sensitive data excluded from logs?",
                "Are logs protected from tampering?",
                "Is log injection prevented?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "Logging sensitive data",
                        "example": "logger.info(\"User login: \" + username + \"/\" + password);",
                        "risk": "Sensitive data exposure"
                    },
                    {
                        "pattern": "Unvalidated input in logs",
                        "example": "logger.info(\"User input: \" + userInput);",
                        "risk": "Log injection"
                    }
                ]
            },
            "remediation_steps": [
                "Sanitize all data before logging",
                "Exclude passwords, tokens, and PII from logs",
                "Implement log integrity protection"
            ],
            "related_guidelines": [
                "SCR-010",
                "SCR-012"
            ]
        },
        {
            "id": "SCR-012",
            "category": "file_handling",
            "priority": "high",
            "title": "Implement secure file upload and handling",
            "essential_checks": [
                "Are file types validated against allowlists?",
                "Are file sizes limited appropriately?",
                "Are uploaded files stored securely?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "No file type validation",
                        "example": "file.transferTo(new File(uploadDir + filename));",
                        "risk": "Malicious file upload"
                    },
                    {
                        "pattern": "Executable file upload",
                        "example": "if (filename.endsWith(\".jpg\")) // Bypassable",
                        "risk": "Code execution"
                    }
                ]
            },
            "remediation_steps": [
                "Validate file types using magic numbers",
                "Store uploads outside web root",
                "Scan files for malware before processing"
            ],
            "related_guidelines": [
                "SCR-001",
                "SCR-013"
            ]
        },
        {
            "id": "SCR-013",
            "category": "path_security",
            "priority": "high",
            "title": "Prevent path traversal vulnerabilities",
            "essential_checks": [
                "Are file paths validated and canonicalized?",
                "Is access restricted to intended directories?",
                "Are path traversal sequences blocked?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "Unvalidated file path",
                        "example": "File file = new File(baseDir + userPath);",
                        "risk": "Path traversal"
                    },
                    {
                        "pattern": "Directory traversal sequences",
                        "example": "filename.contains(\"../\") // Insufficient check",
                        "risk": "Directory escape"
                    }
                ]
            },
            "remediation_steps": [
                "Use Path.normalize() and validate canonical paths",
                "Implement allowlist-based path validation",
                "Restrict file access to designated directories only"
            ],
            "related_guidelines": [
                "SCR-001",
                "SCR-012"
            ]
        },
        {
            "id": "SCR-014",
            "category": "csrf_protection",
            "priority": "high",
            "title": "Implement CSRF protection for state-changing operations",
            "essential_checks": [
                "Are CSRF tokens present on forms?",
                "Are tokens validated server-side?",
                "Are state-changing operations protected?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "State-changing GET request",
                        "example": "@GetMapping(\"/delete/{id}\") public void deleteUser(@PathVariable int id)",
                        "risk": "CSRF attack"
                    },
                    {
                        "pattern": "Missing CSRF token validation",
                        "example": "// POST endpoint without token check",
                        "risk": "Cross-site request forgery"
                    }
                ]
            },
            "remediation_steps": [
                "Use POST/PUT/DELETE for state-changing operations",
                "Implement synchronizer token pattern",
                "Validate CSRF tokens on all state-changing requests"
            ],
            "related_guidelines": [
                "SCR-004",
                "SCR-005"
            ]
        },
        {
            "id": "SCR-015",
            "category": "xml_security",
            "priority": "high",
            "title": "Secure XML processing against injection attacks",
            "essential_checks": [
                "Are XML parsers configured securely?",
                "Is external entity processing disabled?",
                "Is XML input validated before processing?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "Unsafe XML parser configuration",
                        "example": "DocumentBuilderFactory.newInstance(); // Default unsafe config",
                        "risk": "XXE injection"
                    },
                    {
                        "pattern": "External entity enabled",
                        "example": "parser.setFeature(XMLConstants.FEATURE_SECURE_PROCESSING, false);",
                        "risk": "External entity attack"
                    }
                ]
            },
            "remediation_steps": [
                "Disable external entity processing",
                "Use secure parser configurations",
                "Validate XML structure against schemas"
            ],
            "related_guidelines": [
                "SCR-001",
                "SCR-002"
            ]
        },
        {
            "id": "SCR-016",
            "category": "deserialization",
            "priority": "critical",
            "title": "Avoid unsafe deserialization of untrusted data",
            "essential_checks": [
                "Is deserialization of untrusted data avoided?",
                "Are object types validated before deserialization?",
                "Are safer alternatives used when possible?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "Direct object deserialization",
                        "example": "ObjectInputStream.readObject() // From untrusted source",
                        "risk": "Remote code execution"
                    },
                    {
                        "pattern": "Unsafe JSON deserialization",
                        "example": "mapper.readValue(userInput, Object.class);",
                        "risk": "Deserialization attack"
                    }
                ]
            },
            "remediation_steps": [
                "Use data formats like JSON instead of native serialization",
                "Implement allowlist-based type validation",
                "Use libraries with built-in protection mechanisms"
            ],
            "related_guidelines": [
                "SCR-001",
                "SCR-017"
            ]
        },
        {
            "id": "SCR-017",
            "category": "command_injection",
            "priority": "critical",
            "title": "Prevent command injection in system calls",
            "essential_checks": [
                "Are system commands avoided when possible?",
                "Is user input properly escaped for shell execution?",
                "Are command parameters validated against allowlists?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "Direct command execution with user input",
                        "example": "Runtime.getRuntime().exec(\"ping \" + userInput);",
                        "risk": "Command injection"
                    },
                    {
                        "pattern": "Shell command with concatenation",
                        "example": "ProcessBuilder pb = new ProcessBuilder(\"sh\", \"-c\", \"ls \" + directory);",
                        "risk": "Shell injection"
                    }
                ]
            },
            "remediation_steps": [
                "Use APIs instead of system commands when possible",
                "Validate and sanitize all command parameters",
                "Use ProcessBuilder with separate arguments"
            ],
            "related_guidelines": [
                "SCR-001",
                "SCR-016"
            ]
        },
        {
            "id": "SCR-018",
            "category": "ldap_security",
            "priority": "high",
            "title": "Prevent LDAP injection attacks",
            "essential_checks": [
                "Are LDAP queries parameterized or escaped?",
                "Is user input validated before LDAP operations?",
                "Are LDAP connections secured?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "LDAP query with string concatenation",
                        "example": "String filter = \"(uid=\" + username + \")\";",
                        "risk": "LDAP injection"
                    },
                    {
                        "pattern": "Unescaped special characters",
                        "example": "searchFilter = \"(cn=\" + userInput + \")\"; // No escaping",
                        "risk": "LDAP filter bypass"
                    }
                ]
            },
            "remediation_steps": [
                "Escape LDAP special characters in user input",
                "Use parameterized LDAP queries when available",
                "Validate input against expected patterns"
            ],
            "related_guidelines": [
                "SCR-001",
                "SCR-002"
            ]
        },
        {
            "id": "SCR-019",
            "category": "race_conditions",
            "priority": "medium",
            "title": "Prevent race conditions in concurrent operations",
            "essential_checks": [
                "Are shared resources properly synchronized?",
                "Are atomic operations used for critical sections?",
                "Is the time-of-check-time-of-use pattern avoided?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "Check-then-act without synchronization",
                        "example": "if (balance >= amount) { balance -= amount; } // Race condition",
                        "risk": "Data corruption"
                    },
                    {
                        "pattern": "File existence check before use",
                        "example": "if (file.exists()) { file.delete(); } // TOCTOU",
                        "risk": "Time-of-check-time-of-use vulnerability"
                    }
                ]
            },
            "remediation_steps": [
                "Use synchronized blocks or atomic operations",
                "Implement proper locking mechanisms",
                "Combine check-and-act into atomic operations"
            ],
            "related_guidelines": [
                "SCR-020",
                "SCR-021"
            ]
        },
        {
            "id": "SCR-020",
            "category": "resource_management",
            "priority": "medium",
            "title": "Implement proper resource cleanup and limits",
            "essential_checks": [
                "Are resources properly closed in finally blocks?",
                "Are resource limits enforced?",
                "Is resource exhaustion prevented?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "Resource leak",
                        "example": "FileInputStream fis = new FileInputStream(file); // No try-with-resources",
                        "risk": "Resource exhaustion"
                    },
                    {
                        "pattern": "Unbounded resource allocation",
                        "example": "List<String> data = new ArrayList<>(); // No size limit",
                        "risk": "Memory exhaustion"
                    }
                ]
            },
            "remediation_steps": [
                "Use try-with-resources for automatic cleanup",
                "Implement resource pooling and limits",
                "Set timeouts for long-running operations"
            ],
            "related_guidelines": [
                "SCR-019",
                "SCR-021"
            ]
        },
        {
            "id": "SCR-021",
            "category": "dos_prevention",
            "priority": "medium",
            "title": "Implement denial of service protection",
            "essential_checks": [
                "Are rate limits implemented for API endpoints?",
                "Are input size limits enforced?",
                "Are expensive operations protected against abuse?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "No rate limiting",
                        "example": "@PostMapping(\"/api/data\") // No rate limit",
                        "risk": "API abuse"
                    },
                    {
                        "pattern": "Unbounded input processing",
                        "example": "while (scanner.hasNext()) { process(scanner.next()); }",
                        "risk": "Resource exhaustion"
                    }
                ]
            },
            "remediation_steps": [
                "Implement rate limiting on API endpoints",
                "Set maximum input size limits",
                "Use circuit breakers for external dependencies"
            ],
            "related_guidelines": [
                "SCR-019",
                "SCR-020"
            ]
        },
        {
            "id": "SCR-022",
            "category": "redirect_validation",
            "priority": "medium",
            "title": "Validate redirect URLs to prevent open redirects",
            "essential_checks": [
                "Are redirect URLs validated against allowlists?",
                "Is the redirect destination within the application domain?",
                "Are relative redirects used when possible?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "Unvalidated redirect parameter",
                        "example": "return \"redirect:\" + request.getParameter(\"url\");",
                        "risk": "Open redirect"
                    },
                    {
                        "pattern": "External URL redirect",
                        "example": "response.sendRedirect(userProvidedUrl);",
                        "risk": "Phishing attack"
                    }
                ]
            },
            "remediation_steps": [
                "Validate redirect URLs against allowlist",
                "Use indirect references for redirect destinations",
                "Prefer relative URLs for internal redirects"
            ],
            "related_guidelines": [
                "SCR-001",
                "SCR-023"
            ]
        },
        {
            "id": "SCR-023",
            "category": "http_security",
            "priority": "medium",
            "title": "Implement secure HTTP headers",
            "essential_checks": [
                "Are security headers properly configured?",
                "Is HTTPS enforced for sensitive operations?",
                "Are cookies configured securely?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "Missing security headers",
                        "example": "// No X-Frame-Options, CSP, etc.",
                        "risk": "Clickjacking, XSS"
                    },
                    {
                        "pattern": "Insecure cookie configuration",
                        "example": "Cookie cookie = new Cookie(\"session\", value); // No secure flag",
                        "risk": "Session hijacking"
                    }
                ]
            },
            "remediation_steps": [
                "Set Content-Security-Policy headers",
                "Configure X-Frame-Options and X-Content-Type-Options",
                "Use Secure and HttpOnly flags on cookies"
            ],
            "related_guidelines": [
                "SCR-006",
                "SCR-024"
            ]
        },
        {
            "id": "SCR-024",
            "category": "dependency_security",
            "priority": "high",
            "title": "Manage third-party dependencies securely",
            "essential_checks": [
                "Are dependencies regularly updated?",
                "Are known vulnerable dependencies identified?",
                "Is dependency integrity verified?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "Outdated vulnerable dependency",
