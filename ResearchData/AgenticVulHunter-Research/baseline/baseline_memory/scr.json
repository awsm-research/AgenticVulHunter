                ]
            },
            "remediation_steps": [
                "Use dependency scanning tools",
                "Keep dependencies updated to latest secure versions",
                "Verify dependency checksums and signatures"
            ],
            "related_guidelines": [
                "SCR-007",
                "SCR-025"
            ]
        },
        {
            "id": "SCR-025",
            "category": "configuration_security",
            "priority": "high",
            "title": "Secure application configuration and secrets management",
            "essential_checks": [
                "Are secrets stored securely outside source code?",
                "Are default configurations changed?",
                "Is sensitive configuration data encrypted?"
            ],
            "vulnerability_patterns": {
                "high_confidence": [
                    {
                        "pattern": "Hardcoded secrets",
                        "example": "String apiKey = \"sk-1234567890abcdef\";",
                        "risk": "Secret exposure"
                    },
                    {
                        "pattern": "Default configuration",
                        "example": "admin/admin // Default credentials",
                        "risk": "Unauthorized access"
                    },
                    {
